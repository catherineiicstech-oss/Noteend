generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum SystemRole {
  CUSTOMER
  PROJECT_MANAGER
  EDITOR
  QA_REVIEWER
  FINANCE
  SUPER_ADMIN
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  emailVerified  DateTime?
  name           String
  phone          String?
  country        String?
  passwordHash   String?
  image          String?
  isActive       Boolean    @default(true)
  // Staff-only profile fields
  specialties    String[]   @default([])
  bio            String?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  roles              UserRole[]
  accounts           Account[]
  sessions           Session[]
  memberships        OrganizationMember[]
  ownedProjects      Project[]              @relation("ProjectOwner")
  assignments        ProjectAssignment[]
  messages           ProjectMessage[]
  uploadedFiles      ProjectFile[]
  qaReviews          QAReview[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  reviews            Review[]
  quoteRequests      QuoteRequest[]
  invitationsSent    Invitation[]           @relation("InvitationInviter")
  articles           Article[]
  projectEvents      ProjectEvent[]

  @@index([email])
}

model UserRole {
  id     String     @id @default(cuid())
  userId String
  role   SystemRole
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Organizations (tenancy)
// ---------------------------------------------------------------------------

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  industry             String?
  country              String   @default("Uganda")
  logoUrl              String?
  billingEmail         String?
  creditTermsApproved  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  settings      OrganizationSettings?
  members       OrganizationMember[]
  invitations   Invitation[]
  projects      Project[]
  invoices      Invoice[]
  subscriptions Subscription[]
  styleGuides   StyleGuide[]
  quoteRequests QuoteRequest[]

  @@index([slug])
}

model OrganizationSettings {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  englishVariant      String       @default("UK")
  defaultCitationStyle String      @default("APA")
  preferredTerminology String?
  brandGuidelines     String?
  confidentialityNote String?
  documentRetentionDays Int?
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole      @default(MEMBER)
  token          String       @unique
  invitedById    String
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([organizationId, email])
}

// ---------------------------------------------------------------------------
// Service catalogue & pricing
// ---------------------------------------------------------------------------

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  summary     String
  description String
  icon        String?
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  seoTitle    String?
  seoDescription String?
  services    Service[]

  @@index([slug])
}

model Service {
  id          String          @id @default(cuid())
  categoryId  String
  name        String
  slug        String          @unique
  summary     String
  description String
  deliverables String[]       @default([])
  position    Int             @default(0)
  isActive    Boolean         @default(true)
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  pricingRules  PricingRule[]
  projects      Project[]
  quoteRequests QuoteRequest[]
  packageItems  ServicePackageItem[]

  @@index([categoryId])
  @@index([slug])
}

model ServicePackage {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  summary     String
  description String
  priceMinor  Int
  currency    String               @default("UGX")
  isActive    Boolean              @default(true)
  items       ServicePackageItem[]

  @@index([slug])
}

model ServicePackageItem {
  id        String         @id @default(cuid())
  packageId String
  serviceId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
}

enum Complexity {
  STANDARD
  TECHNICAL
  SPECIALIST
}

/// Admin-configurable pricing. Never hard-code rates in application code.
model PricingRule {
  id                  String     @id @default(cuid())
  serviceId           String
  currency            String     @default("UGX")
  /// Price per word in minor currency units (e.g. UGX cents).
  baseRatePerWordMinor Int
  minimumChargeMinor  Int        @default(0)
  /// Percent surcharge per extra file beyond the first.
  extraFilePercent    Int        @default(0)
  formattingFeeMinor  Int        @default(0)
  researchFeeMinor    Int        @default(0)
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  service             Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  complexityMultipliers ComplexityMultiplier[]
  rushMultipliers       RushMultiplier[]

  @@index([serviceId, isActive])
}

model ComplexityMultiplier {
  id            String      @id @default(cuid())
  pricingRuleId String
  complexity    Complexity
  /// Multiplier in basis points (10000 = 1.0x).
  multiplierBps Int
  pricingRule   PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)

  @@unique([pricingRuleId, complexity])
}

model RushMultiplier {
  id            String      @id @default(cuid())
  pricingRuleId String
  /// Applies when the deadline is within this many hours.
  maxHours      Int
  multiplierBps Int
  pricingRule   PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)

  @@index([pricingRuleId, maxHours])
}

model Plan {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  tagline            String
  audience           String
  monthlyPriceMinor  Int
  currency           String         @default("UGX")
  wordAllowance      Int
  features           String[]       @default([])
  prioritySupport    Boolean        @default(false)
  dedicatedEditor    Boolean        @default(false)
  maxUsers           Int            @default(1)
  position           Int            @default(0)
  isActive           Boolean        @default(true)
  subscriptions      Subscription[]

  @@index([slug])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  wordsUsed          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Quotes & projects
// ---------------------------------------------------------------------------

enum QuoteRequestStatus {
  NEW
  REVIEWED
  QUOTED
  CONVERTED
  DECLINED
}

/// Lead captured from the public "Get a Quote" wizard. May be submitted by a guest.
model QuoteRequest {
  id                   String             @id @default(cuid())
  reference            String             @unique
  status               QuoteRequestStatus @default(NEW)
  contactName          String
  contactEmail         String
  contactPhone         String?
  organizationName     String?
  country              String?
  preferredContact     String             @default("EMAIL")
  serviceId            String?
  serviceOther         String?
  documentType         String?
  wordCount            Int
  complexity           Complexity         @default(STANDARD)
  deadline             DateTime
  citationStyle        String?
  industry             String?
  confidentiality      String?
  needsFormatting      Boolean            @default(false)
  needsResearch        Boolean            @default(false)
  description          String
  estimateMinor        Int?
  estimateCurrency     String?
  userId               String?
  organizationId       String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  service      Service?      @relation(fields: [serviceId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  project      Project?
  files        QuoteRequestFile[]

  @@index([status, createdAt])
  @@index([contactEmail])
}

model QuoteRequestFile {
  id             String       @id @default(cuid())
  quoteRequestId String
  filename       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  scanStatus     ScanStatus   @default(PENDING)
  createdAt      DateTime     @default(now())
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
}

enum ProjectStatus {
  DRAFT
  QUOTE_REQUESTED
  QUOTE_SENT
  AWAITING_CUSTOMER_APPROVAL
  AWAITING_PAYMENT
  PAID
  AWAITING_ASSIGNMENT
  ASSIGNED
  IN_PROGRESS
  EDITOR_SUBMITTED
  QA_REVIEW
  REVISION_REQUIRED
  FINAL_REVIEW
  COMPLETED
  DELIVERED
  CLOSED
  CANCELLED
}

model Project {
  id              String        @id @default(cuid())
  reference       String        @unique
  title           String
  status          ProjectStatus @default(DRAFT)
  serviceId       String
  ownerUserId     String
  organizationId  String?
  quoteRequestId  String?       @unique
  documentType    String?
  wordCount       Int
  complexity      Complexity    @default(STANDARD)
  deadline        DateTime
  citationStyle   String?
  industry        String?
  confidentiality String?
  instructions    String?
  needsFormatting Boolean       @default(false)
  needsResearch   Boolean       @default(false)
  isPremium       Boolean       @default(true)
  deliveredAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  service      Service       @relation(fields: [serviceId], references: [id])
  owner        User          @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id])

  quotes      Quote[]
  files       ProjectFile[]
  messages    ProjectMessage[]
  assignments ProjectAssignment[]
  events      ProjectEvent[]
  qaReviews   QAReview[]
  invoices    Invoice[]
  review      Review?

  @@index([ownerUserId, status])
  @@index([organizationId, status])
  @@index([status, deadline])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id            String      @id @default(cuid())
  reference     String      @unique
  projectId     String
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("UGX")
  subtotalMinor Int
  discountMinor Int         @default(0)
  taxMinor      Int         @default(0)
  totalMinor    Int
  notes         String?
  validUntil    DateTime
  sentAt        DateTime?
  respondedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items         QuoteItem[]
  invoice       Invoice?

  @@index([projectId, status])
}

model QuoteItem {
  id            String @id @default(cuid())
  quoteId       String
  description   String
  quantity      Int    @default(1)
  unitPriceMinor Int
  totalMinor    Int
  quote         Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

enum ProjectRole {
  PROJECT_MANAGER
  EDITOR
  QA_REVIEWER
}

model ProjectAssignment {
  id         String      @id @default(cuid())
  projectId  String
  userId     String
  role       ProjectRole
  assignedAt DateTime    @default(now())
  unassignedAt DateTime?
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, role])
  @@index([userId, unassignedAt])
}

enum FileKind {
  ORIGINAL
  WORKING
  EDITED
  QA
  FINAL
  REFERENCE
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

model ProjectFile {
  id          String     @id @default(cuid())
  projectId   String
  kind        FileKind
  version     Int        @default(1)
  filename    String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  scanStatus  ScanStatus @default(PENDING)
  /// Internal working files are never exposed to the customer.
  customerVisible Boolean @default(false)
  uploadedById String
  note        String?
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy  User       @relation(fields: [uploadedById], references: [id])

  @@index([projectId, kind, version])
}

enum MessageVisibility {
  CUSTOMER
  INTERNAL
}

model ProjectMessage {
  id         String            @id @default(cuid())
  projectId  String
  authorId   String
  visibility MessageVisibility @default(CUSTOMER)
  body       String
  readBy     String[]          @default([])
  createdAt  DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  actorId   String?
  type      String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([projectId, createdAt])
}

enum QAOutcome {
  PASS
  FAIL
  NEEDS_REVISION
}

model QAReview {
  id         String            @id @default(cuid())
  projectId  String
  reviewerId String
  outcome    QAOutcome?
  comments   String?
  submittedAt DateTime?
  createdAt  DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer   User              @relation(fields: [reviewerId], references: [id])
  items      QAChecklistItem[]

  @@index([projectId, createdAt])
}

model QAChecklistItem {
  id       String   @id @default(cuid())
  reviewId String
  section  String
  label    String
  checked  Boolean  @default(false)
  note     String?
  position Int      @default(0)
  review   QAReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Review {
  id        String   @id @default(cuid())
  projectId String   @unique
  authorId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  REFUNDED
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  status         InvoiceStatus @default(DRAFT)
  projectId      String?
  quoteId        String?       @unique
  organizationId String?
  billToName     String
  billToEmail    String
  currency       String        @default("UGX")
  subtotalMinor  Int
  taxMinor       Int           @default(0)
  totalMinor     Int
  amountPaidMinor Int          @default(0)
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project      Project?      @relation(fields: [projectId], references: [id])
  quote        Quote?        @relation(fields: [quoteId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@index([status, issuedAt])
  @@index([organizationId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Int     @default(1)
  unitPriceMinor Int
  totalMinor     Int
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  provider      String
  providerRef   String?
  method        String
  status        PaymentStatus @default(PENDING)
  currency      String        @default("UGX")
  amountMinor   Int
  refundedMinor Int           @default(0)
  failureReason String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, status])
  @@index([provider, providerRef])
}

// ---------------------------------------------------------------------------
// Content & operations
// ---------------------------------------------------------------------------

enum ArticleType {
  ARTICLE
  GUIDE
  TEMPLATE
  CHECKLIST
  CASE_STUDY
}

model Article {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  type           ArticleType @default(ARTICLE)
  excerpt        String
  body           String
  tags           String[]    @default([])
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean     @default(false)
  publishedAt    DateTime?
  authorId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  author         User?       @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([isPublished, publishedAt])
}

model Industry {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  summary        String
  problems       String[] @default([])
  solutions      String[] @default([])
  seoTitle       String?
  seoDescription String?
  position       Int     @default(0)
  isActive       Boolean @default(true)

  @@index([slug])
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  topic    String  @default("general")
  position Int     @default(0)
  isActive Boolean @default(true)

  @@index([topic, position])
}

/// Placeholder-flagged social proof. Never seeded with fabricated content.
model Testimonial {
  id            String  @id @default(cuid())
  quote         String
  authorName    String
  authorRole    String?
  organization  String?
  isPlaceholder Boolean @default(true)
  isPublished   Boolean @default(false)
  position      Int     @default(0)
}

model StyleGuide {
  id             String        @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  storageKey     String?
  body           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  storageKey  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Outbox for asynchronous delivery; keeps notification transport swappable.
model OutboundMessage {
  id          String    @id @default(cuid())
  channel     String    @default("EMAIL")
  recipient   String
  subject     String
  body        String
  status      String    @default("QUEUED")
  attempts    Int       @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

/// Key/value application configuration so nothing important needs a code change.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id])

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
}
