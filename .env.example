# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://scriptor:scriptor@localhost:5432/scriptor?schema=public"

# Public origin of the app. Used for links in emails and OAuth callbacks.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Session/JWT signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-string"

# ---------------------------------------------------------------------------
# Branding (no code change required to rebrand)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="Scriptor"
NEXT_PUBLIC_BRAND_TAGLINE="Professional Writing, Research, Editing & Documentation"
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_CONTACT_PHONE="+256 000 000 000"

# ---------------------------------------------------------------------------
# File storage (S3-compatible). Local dev uses MinIO from docker-compose.yml.
# ---------------------------------------------------------------------------
# One of: s3 | local
STORAGE_DRIVER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="scriptor-documents"
S3_ACCESS_KEY_ID="scriptor"
S3_SECRET_ACCESS_KEY="scriptor-dev-secret"
# Required for MinIO; set to false for AWS S3.
S3_FORCE_PATH_STYLE="true"
# Seconds a download URL stays valid.
S3_SIGNED_URL_TTL="120"
# Directory used when STORAGE_DRIVER=local.
LOCAL_STORAGE_DIR=".storage"

# Upload limits.
MAX_UPLOAD_BYTES="26214400"

# ---------------------------------------------------------------------------
# Mail. One of: log | smtp
# ---------------------------------------------------------------------------
MAIL_DRIVER="log"
MAIL_FROM="Scriptor <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# Payments. Comma-separated list of enabled providers.
# Available: manual_bank_transfer, mobile_money_stub
# ---------------------------------------------------------------------------
PAYMENT_PROVIDERS="manual_bank_transfer,mobile_money_stub"

# ---------------------------------------------------------------------------
# Optional OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ---------------------------------------------------------------------------
# Seed credentials (development only)
# ---------------------------------------------------------------------------
SEED_PASSWORD="Password123!"
